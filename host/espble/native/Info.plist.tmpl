<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>@@HELPER_NAME@@</string>
  <key>CFBundleExecutable</key>
  <string>@@HELPER_NAME@@</string>
  <key>CFBundleName</key>
  <string>@@HELPER_NAME@@</string>

  <!-- ⚠️ 每个 helper 必须有**独立**的 bundle id。
       复用别人的 id 会让 LaunchServices 把两个 app 当成同一个:
       启动其中一个,另一个就再也起不来(而且报错毫无提示性)。
       build_helper.sh 会用 mdfind 查一遍撞没撞。 -->
  <key>CFBundleIdentifier</key>
  <string>@@BUNDLE_ID@@</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@@VERSION@@</string>
  <key>CFBundleVersion</key>
  <string>@@VERSION@@</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>

  <!-- 后台 agent:不进 Dock、不抢焦点 -->
  <key>LSUIElement</key>
  <true/>

  <!-- ⚠️ TCC 弹框文案。缺了这两个 key,系统**不会弹授权框而是直接拒绝**,
       现象是 central 永远进不了 poweredOn,极难往权限上想。 -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>@@USAGE_DESC@@</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>@@USAGE_DESC@@</string>

  <key>NSPrincipalClass</key>
  <string>NSApplication</string>

  <!-- 菜单栏模式(双击打开、不带 --session-dir)用的默认值。
       无界面 worker 模式不读这些,它的一切都来自命令行参数。

       ⚠️ DEVICE_NAME 和 NAME_PREFIX 至少要给一个。两个都空 → 菜单栏实例不可能匹配到
       任何设备,它会直接不扫描,并在菜单里显示「未配置匹配条件」。
       (曾经因为构建时漏了 --name-prefix,一个实例空扫了 9 天。) -->
  <key>ESPBLEDeviceName</key>
  <string>@@DEVICE_NAME@@</string>
  <key>ESPBLENamePrefix</key>
  <string>@@NAME_PREFIX@@</string>
  <key>ESPBLESessionDir</key>
  <string>@@SESSION_DIR@@</string>

  <!-- BleHub(多设备)模式:注册表 + 每台设备的会话根目录。
       留空则用代码里的默认值 ~/.config/espble/{devices.json,sessions}。 -->
  <key>ESPBLERegistry</key>
  <string>@@DEV_REGISTRY@@</string>
  <key>ESPBLESessionRoot</key>
  <string>@@SESSION_ROOT@@</string>
</dict>
</plist>
